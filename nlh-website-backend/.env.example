# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nlh_website_db

# Better-Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# CORS / frontend origin
FRONTEND_URL=http://localhost:5173

# Single-admin gate: only this email can perform write operations
ADMIN_EMAIL=you@example.com

# Uploads
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_URL=http://localhost:3001/uploads